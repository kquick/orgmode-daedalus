dev =
  subcmd =
    build =
      Builds the project
        exec = cabal build orgmode-daedalus

    update_nix_derivs =
      Update local static nix derivations
        in dir = {TopDir}/nix
        exec = |
          set -e
          mkDeriv () { echo :::: Github $1 / $2 derivation generation; nix run nixpkgs#cabal2nix -- https://github.com/${1}/${2} --revision=$(nix flake metadata --json | nix run nixpkgs#jq -- -r --arg SRC "${2}-src" '.locks.nodes.[$SRC].locked.rev') > ${2}.nix; }
          mkDerivD () { echo :::: Daedalus $1 derivation generation; nix run nixpkgs#cabal2nix https://github.com/GaloisInc/daedalus -- --subpath=$1 --revision=$(nix flake metadata --json | nix run nixpkgs#jq -- -r --arg SRC "${1}" '.locks.nodes.["daedalus-src"].locked.rev') > ${1}.nix; }
          nix run nixpkgs#cabal2nix .. > orgmode-daedalus.nix
          mkDeriv mesabloo diagnose
          mkDeriv GaloisInc alex-tools
          mkDeriv GaloisInc bv-sized
          mkDeriv GaloisInc language-rust
          mkDeriv GaloisInc parameterized-utils
          mkDeriv GaloisInc daedalus
          mkDerivD daedalus-core
          mkDerivD daedalus-vm
          mkDerivD daedalus-utils
          mkDerivD daedalus-value
          mkDerivD rts-hs
          mkDerivD rts-hs-data
          mkDerivD rts-vm-hs
          nix run nixpkgs#cabal2nix https://github.com/monadfix/microlens -- --subpath=microlens --revision=$(nix flake metadata --json | nix run nixpkgs#jq '.locks.nodes."microlens-src".locked.rev' | sed -e 's,",,g') > microlens.nix

    flake_update =
      Update flake dependencies =
        in dir = {TopDir}
        exec = nix flake update --option tarball-ttl 60

    nixbuild
      Uses nix to build with current GHC versions
        in dir = {TopDir}
        notes =
           * GHC 9.14 waiting on: alex-tools hedgehog-classes tasty-hspec rebase
        exec = nix build --no-link .#orgmode-daedalus.ghc910 .#orgmode-daedalus.ghc912

    nixbuild:old
      Uses nix to build with old GHC versions
        in dir = {TopDir}
        notes =
          * singletons-th is particularly sensitive to dependency versions.
          * singletons-base is marked as broken in 24.05
          * GHC 8.10 in nixpkgs does not have effectful-core which was only
            introduced in 2022 (circa GHC 9.2).
        exec =
          set -e
          echo :::: orgmode-daedalus ghc92
          nix build --no-link .#orgmode-daedalus.ghc92 --override-input nixpkgs github:nixos/nixpkgs/23.05
          echo :::: orgmode-daedalus ghc94
          nix build --no-link .#orgmode-daedalus.ghc94 --override-input nixpkgs github:nixos/nixpkgs/23.11

    nixbuild:recent
      Uses nix to build with recent GHC versions
        in dir = {TopDir}
        exec =
          set -e
          echo :::: orgmode-daedalus ghc96
          nix build --no-link .#orgmode-daedalus.ghc96 --override-input nixpkgs github:nixos/nixpkgs/24.11
          echo :::: orgmode-daedalus ghc98
          nix build --no-link .#orgmode-daedalus.ghc98 --override-input nixpkgs github:nixos/nixpkgs/25.05

    nixbuild:all =
      Uses nix to build with all supported GHC versions =
        in dir = {TopDir}
        needs = nixbuild nixbuild:old nixbuild:recent
        exec = echo All nix builds completed

    test =
      testcase =
        orgmode-daedalus-test =
          type = EXE
          runner = cabal

      testrunner =
        cabal =
          exec = cabal run {TestName}
